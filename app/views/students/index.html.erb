<h1>All Students</h1>
<table>
  <thead>
    <tr>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Email</th>
      <th>Actions</th>
      <th>Edit</th>
      <th>Delete</th>
    </tr>
  </thead>
  <tbody>
    <% @students.each do |student| %>
      <tr>
        <td><%= student.first_name %></td>
        <td><%= student.last_name %></td>
        <td><%= student.email %></td>
        <td>
          <%= link_to 'View', student_path(student) %>
        </td>
        <td>
          <%= link_to 'Edit', edit_student_path(student) %>
        </td>
        <td>
          <%= link_to 'Delete', student(student), method: :delete, confirm: 'Are you sure?' %>
        </td>
      </tr>
    <% end %>
  </tbody>